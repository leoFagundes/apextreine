rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    // Others can only read public profiles
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || resource.data.isPublic == true);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Exercises: owner full access, others read if public
    match /exercises/{exerciseId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || resource.data.isPublic == true);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Workouts: owner full access, others read if public
    match /workouts/{workoutId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || resource.data.isPublic == true);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.uid ||
         // Allow others to update likes array only
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Sessions: private to owner
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // Body metrics: private to owner
    match /metrics/{metricId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
  }
}
